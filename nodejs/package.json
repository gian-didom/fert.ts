{
  "name": "@gian-didom/fert-node",
  "version": "0.9.9",
  "description": "Fast Ephemeris Retrieval Tool (FERT) - Node.js bindings",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/gian-didom/fert-ts.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "cmake-js build --CDNAPI_VERSION=8",
    "rebuild": "cmake-js rebuild --CDNAPI_VERSION=8", 
    "test": "node example.js",
    "clean": "cmake-js clean",
    "prebuild": "prebuild --all",
    "postinstall": "node scripts/check-dependencies.js",
    "install": "prebuild-install || echo 'Warning: No prebuilt binary found. You may need to build from source.'"
  },
  "keywords": [
    "ephemeris",
    "spice",
    "astronomy",
    "orbital-mechanics",
    "native-addon"
  ],
  "author": "DART Lab - Politecnico di Milano",
  "license": "MIT",
  "dependencies": {
    "cmake-js": "^7.3.0",
    "prebuild-install": "^7.1.1"
  },
  "devDependencies": {
    "bindings": "^1.5.0",
    "prebuild": "^13.0.1"
  },
  "files": [
    "index.js",
    "prebuilds/",
    "scripts/check-dependencies.js"
  ],
  "binary": {
    "napi_versions": [3, 4, 5, 6, 7, 8]
  }
}
